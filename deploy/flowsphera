#!/bin/sh
# FlowSphera on this server (installed by install.sh as /usr/local/bin/flowsphera; /usr/local/bin/flowtrack is a synonym
# that says so, until 3.0):
#   flowsphera upgrade [--force] [--license FILE|CODE]   newest version from GitHub, settings and data kept
#   flowsphera status                                    version, services, edition
#   flowsphera license status|request|activate FILE|renew|deactivate
#   flowsphera reconfigure                               the installer's questions again (ports, device, password …)
#   flowsphera uninstall                                 remove FlowSphera (asks whether to keep the data)
#   flowsphera backup [now|list|verify|prune|copy] …     backups (backup.py); flowsphera restore [ID] [--from …] …
# FT_INSTALL_URL overrides where the installer comes from (testing).
REPO=telesphera/flowsphera
PREFIX=/opt/flowsphera
ETC=/etc/flowsphera
URL=${FT_INSTALL_URL:-https://raw.githubusercontent.com/$REPO/main/install.sh}
L=$(cat "$ETC/install-lang" 2>/dev/null || echo en)
t() { if [ "$L" = uk ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

usage() {
  if [ "$L" = uk ]; then cat <<'TXT'
FlowSphera на цьому сервері:
  sudo flowsphera upgrade [--force] [--license ФАЙЛ|КОД]  найновіша версія з GitHub; налаштування й дані зберігаються
  flowsphera status                                       версія, сервіси, редакція
  sudo flowsphera license status|request|activate ФАЙЛ|renew|deactivate
  sudo flowsphera reconfigure                             питання інсталятора ще раз (порти, пристрій, пароль …)
  sudo flowsphera uninstall                               видалити FlowSphera (спитає, чи зберегти дані)
  sudo flowsphera backup [--full]                         бекап зараз (даних і налаштувань; копії — як у «Налаштування → Бекапи»)
  sudo flowsphera backup list [--from s3|sftp|ftp|ТЕКА]   бекапи тут або на іншому місці
  sudo flowsphera backup verify [ID] [--deep]             перевірити бекап (--deep: відновити в тимчасову базу)
  sudo flowsphera restore [ID] [--from s3|sftp|ftp|ТЕКА] [--only-settings|--only-data] [--with-license] [--unencrypted]
TXT
  else cat <<'TXT'
FlowSphera on this server:
  sudo flowsphera upgrade [--force] [--license FILE|CODE]  newest version from GitHub; settings and data are kept
  flowsphera status                                       version, services, edition
  sudo flowsphera license status|request|activate FILE|renew|deactivate
  sudo flowsphera reconfigure                             the installer's questions again (ports, device, password …)
  sudo flowsphera uninstall                               remove FlowSphera (asks whether to keep the data)
  sudo flowsphera backup [--full]                         a backup now (data and settings; copies as in Settings → Backups)
  sudo flowsphera backup list [--from s3|sftp|ftp|DIR]    backups here or on another place
  sudo flowsphera backup verify [ID] [--deep]             check a backup (--deep: restore it into a scratch database)
  sudo flowsphera restore [ID] [--from s3|sftp|ftp|DIR] [--only-settings|--only-data] [--with-license] [--unencrypted]
TXT
  fi
}

root() { [ "$(id -u)" = 0 ] || exec sudo FT_INSTALL_URL="${FT_INSTALL_URL:-}" "$0" "$@"; }

# the installer, downloaded whole before it runs, with the language of this install
installer() {
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  if ! curl -fsSL --retry 2 -o "$tmp/install.sh" "$URL?$(date +%s)"; then
    echo "$(t 'Could not download the installer from' 'Не вдалося завантажити інсталятор з') $URL" >&2; exit 1
  fi
  bash "$tmp/install.sh" --lang "$L" "$@"
}

version() { cat "$PREFIX/app/VERSION" 2>/dev/null || echo '?'; }
# (2.0.0) the build of that version: fixes published without a new number (build 1 = the release; no file = 1)
build() { b=$(cat "$PREFIX/app/BUILD" 2>/dev/null | tr -dc 0-9); echo "${b:-1}"; }
shown() { if [ "$2" -gt 1 ] 2>/dev/null; then echo "$1 $(t "build $2" "збірка $2")"; else echo "$1"; fi; }

case "${1:-}" in
  upgrade)
    root "$@"; shift
    force=0; n=$#
    while [ "$n" -gt 0 ]; do                  # take --force out, keep the rest (a license file name may have spaces)
      a=$1; shift; n=$((n - 1))
      if [ "$a" = --force ]; then force=1; else set -- "$@" "$a"; fi
    done
    cur=$(version); cb=$(build); new=$(curl -fsSL "${URL%/install.sh}/VERSION?$(date +%s)" 2>/dev/null | tr -d '[:space:]')
    nb=$([ -n "$new" ] && curl -fsSL "${URL%/install.sh}/BUILD?$(date +%s)" 2>/dev/null | tr -dc 0-9); nb=${nb:-1}
    c=$(shown "$cur" "$cb"); p=$(shown "$new" "$nb")      # compared as version.build: 2.0.0.2 < 2.0.0.3 < 2.0.1.1
    if [ -n "$new" ] && [ "$new.$nb" = "$cur.$cb" ] && [ "$force" = 0 ] && [ $# = 0 ]; then
      echo "$(t "FlowSphera $c is the latest version." "FlowSphera $c — найновіша версія.") $(t '(flowsphera upgrade --force installs it again)' '(flowsphera upgrade --force встановить її ще раз)')"
      exit 0
    fi
    # never go back to an older version by accident (e.g. a build newer than the published one)
    if [ -n "$new" ] && [ "$new.$nb" != "$cur.$cb" ] && [ "$(printf '%s\n%s\n' "$new.$nb" "$cur.$cb" | sort -V | tail -1)" = "$cur.$cb" ] && [ "$force" = 0 ]; then
      echo "$(t "Installed FlowSphera $c is newer than the published $p; nothing to do (--force installs $p)." "Встановлений FlowSphera $c новіший за опублікований $p; нічого не роблю (--force встановить $p).")"
      exit 0
    fi
    [ -n "$new" ] && [ "$new.$nb" != "$cur.$cb" ] && echo "FlowSphera $c → $p"
    installer --upgrade --yes "$@" ;;
  web-upgrade)
    # (2.11.0) «Upgrade now» in the web interface: started (as root, without a terminal) by flowsphera-upgrade.path when
    # the web service wrote STATE/upgrade.request; the output goes to STATE/upgrade.log, the state to
    # STATE/upgrade_status.json — the page shows both, also while the upgrade restarts the web service
    root "$@"
    S=${FT_STATE_DIR:-/var/lib/flowsphera}
    [ -f "$S/upgrade.request" ] || exit 0
    rm -f "$S/upgrade.request"
    from=$(version); fb=$(build); t0=$(date +%s)
    st() { printf '{"state":"%s","from":"%s","from_build":%s,"to":"%s","to_build":%s,"started":%s,"ended":%s,"rc":%s}\n' \
             "$1" "$from" "$fb" "$(version)" "$(build)" "$t0" "${2:-null}" "${3:-null}" > "$S/upgrade_status.json.tmp" \
           && chmod 644 "$S/upgrade_status.json.tmp" && mv -f "$S/upgrade_status.json.tmp" "$S/upgrade_status.json"; }
    st running
    : > "$S/upgrade.log"; chmod 644 "$S/upgrade.log"
    echo "$(date '+%F %T') $(t 'Upgrade asked from the web interface' 'Оновлення запущене з веб-інтерфейсу'): FlowSphera $(shown "$from" "$fb")" >> "$S/upgrade.log"
    TERM=dumb "$0" upgrade < /dev/null >> "$S/upgrade.log" 2>&1; rc=$?
    echo "$(date '+%F %T') $(t 'Finished' 'Завершено'): FlowSphera $(shown "$(version)" "$(build)") (rc=$rc)" >> "$S/upgrade.log"
    if [ "$rc" = 0 ]; then st done "$(date +%s)" 0; else st failed "$(date +%s)" "$rc"; fi
    exit "$rc" ;;
  reconfigure) root "$@"; installer ;;
  uninstall) root "$@"; installer --uninstall ;;
  license) shift; exec /usr/local/bin/flowsphera-license "$@" ;;
  backup|restore) root "$@"; exec "$PREFIX/venv/bin/python" "$PREFIX/app/backup.py" "$@" ;;
  status)
    echo "FlowSphera $(shown "$(version)" "$(build)")"
    for u in flowsphera-collector flowsphera-web; do printf '  %-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"; done
    # (2.12.4, forum #84) where the page is now: the address may change (DHCP) or be missing for a while (Wi-Fi, the router
    # restarting) — the web interface waits for it and answers again as soon as it is back;
    # what the web service listens on now (ss needs no root; the env file is root's only)
    wp=$(sed -n 's/^FT_WEB_PORT=//p' /etc/flowsphera/env 2>/dev/null | tr -d '"'); wp=${wp:-3030}
    ls=$(ss -ltnH "sport = :$wp" 2>/dev/null | awk '{print $4}' | sed -E 's/:[0-9]+$//; s/^\[(.*)\]$/\1/' | grep -v -E '^(127\.|::1$)' | sort -u)
    case " $(echo $ls) " in
      *" 0.0.0.0 "*|*" * "*|*" :: "*) as=$(ip -o -4 addr show scope global 2>/dev/null | grep -v -E ' (docker[0-9]*|br-[0-9a-f]+|virbr[0-9]*|veth[^ ]*) ' | awk '{split($4, a, "/"); print a[1]}') ;;
      *) as=$ls ;;
    esac
    gone=""; for a in $as; do ip -o addr show 2>/dev/null | grep -q " ${a}/" || gone="$gone $a"; done
    for a in $as; do case " $gone " in *" $a "*) ;; *) case $a in *:*) echo "  $(t 'Web interface' 'Веб-інтерфейс'):  https://[$a]:$wp" ;; *) echo "  $(t 'Web interface' 'Веб-інтерфейс'):  https://$a:$wp" ;; esac ;; esac; done
    if [ -n "$gone" ] || { [ -z "$as" ] && [ "$(systemctl is-active flowsphera-web 2>/dev/null)" = active ]; }; then
      echo "  $(t 'Web interface' 'Веб-інтерфейс'):  $(t "waiting for the server's address$gone (Wi-Fi or the router may be restarting): the page answers again as soon as it is back" "чекаємо адресу сервера$gone (Wi-Fi чи роутер можуть перезапускатися): сторінка відповість, щойно вона повернеться")"
    fi
    [ -x /usr/local/bin/flowsphera-license ] && /usr/local/bin/flowsphera-license status | sed 's/^/  /' ;;
  version|--version|-v) shown "$(version)" "$(build)" ;;
  ''|help|-h|--help) usage ;;
  *) echo "$(t 'Unknown command:' 'Невідома команда:') $1" >&2; usage >&2; exit 2 ;;
esac
